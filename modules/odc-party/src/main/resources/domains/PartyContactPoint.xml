<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.0.xsd">
  <module name="odc-party" package="com.odc.party.db"/>
  <entity name="PartyContactPoint" table="odc_party_contact_point">
    <many-to-one name="party" title="Party" ref="Party" required="true"/>
    <string name="type" title="Contact type" required="true" selection="odc.party.contact.type"/>
    <string name="value" title="Value" required="true"/>
    <string name="label" title="Label"/>
    <boolean name="isPrimary" title="Primary" default="false"/>
    <boolean name="active" title="Active" default="true"/>
  </entity>
</domain-models>
