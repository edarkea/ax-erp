<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.0.xsd">
  <module name="odc-accounting" package="com.odc.accounting.db"/>
  <entity name="AccountingPeriod" table="odc_accounting_period"
    extends="com.odc.organization.db.OdcAuditableModel">
    <many-to-one name="company" title="Company"
      ref="com.odc.organization.db.Company" required="true"/>
    <string name="code" title="Code" required="true"/>
    <string name="name" title="Name" required="true" namecolumn="true"/>
    <date name="startDate" title="Start date" required="true"/>
    <date name="endDate" title="End date" required="true"/>
    <string name="status" title="Status"
      selection="odc.accounting.period.status" default="DRAFT" required="true"/>
    <integer name="sequence" title="Sequence" default="0"/>
    <string name="notes" title="Notes" large="true"/>
  </entity>
</domain-models>
