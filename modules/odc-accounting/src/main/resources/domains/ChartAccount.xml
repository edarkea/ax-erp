<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.0.xsd">
  <module name="odc-accounting" package="com.odc.accounting.db"/>
  <entity name="ChartAccount" table="odc_chart_account"
    extends="com.odc.organization.db.OdcAuditableModel">
    <many-to-one name="company" title="Company" ref="com.odc.organization.db.Company" required="true"/>
    <string name="code" title="Code" required="true"/>
    <string name="name" title="Name" required="true" namecolumn="true"/>
    <string name="accountType" title="Account type"
      selection="odc.accounting.account.type" required="true"/>
    <string name="normalBalance" title="Normal balance"
      selection="odc.accounting.normal.balance" required="true"/>
    <boolean name="isPosting" title="Posting account" default="false"/>
    <many-to-one name="parent" title="Parent account" ref="ChartAccount"/>
    <one-to-many name="children" title="Child accounts" ref="ChartAccount" mappedBy="parent"/>
    <integer name="sequence" title="Sequence" default="0"/>
    <string name="description" title="Description" large="true"/>
    <boolean name="active" title="Active" default="true"/>
  </entity>
</domain-models>
