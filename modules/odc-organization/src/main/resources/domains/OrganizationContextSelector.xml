<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.0.xsd">
  <module name="odc-organization" package="com.odc.organization.db"/>
  <entity name="OrganizationContextSelector" persistable="false">
    <string name="userName" title="User"/>
    <string name="status" title="Status"/>
    <string name="message" title="Message"/>
    <many-to-one name="company" title="Active company" ref="Company"/>
    <many-to-one name="branch" title="Active branch" ref="Branch"/>
  </entity>
</domain-models>
