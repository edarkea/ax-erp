<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.0.xsd">

  <module name="odc-reference" package="com.odc.reference.db"/>

  <entity name="State" table="odc_state">
    <string name="code" title="Code" required="true"/>
    <string name="name" title="Name" required="true"/>
    <many-to-one name="country" title="Country" ref="Country" required="true"/>
    <one-to-many name="cities" title="Cities" ref="City" mappedBy="state"/>
  </entity>

</domain-models>
